# Plantilla para el servidor de produccion.
#
# En el VPS:  cp .env.produccion.example .env  y rellena lo de abajo.
# `.env` esta en .gitignore y NUNCA se sube al repositorio (§51).

# --- Dominio y TLS ---------------------------------------------------------
DOMINIO=lalonja-trading.com
# Correo para Let's Encrypt: solo lo usan para avisar si un certificado va a
# caducar sin renovarse. No se publica.
ACME_EMAIL=tu@correo.com

# --- Base de datos ---------------------------------------------------------
POSTGRES_USER=lalonja
# Generala:  python3 -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=
POSTGRES_DB=lalonja

# --- Seguridad -------------------------------------------------------------
# Generala:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Sin ella la API se niega a arrancar en produccion, a proposito.
JWT_SECRET=

# --- Proveedores de datos --------------------------------------------------
# SEC EDGAR no usa clave, pero exige identificarse en el User-Agent o devuelve
# 403. Pon un correo real.
SEC_USER_AGENT="lalonjatrading tu@correo.com"

ENTORNO=produccion
DEBUG=false
