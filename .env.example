# Copia este fichero a `.env` y rellena los valores.
# `.env` esta en .gitignore y NUNCA debe subirse al repositorio (§51).

ENTORNO=desarrollo
DEBUG=true

# --- Base de datos y cache -------------------------------------------------
POSTGRES_USER=lalonja
POSTGRES_PASSWORD=cambia-esto
POSTGRES_DB=lalonja
DATABASE_URL=postgresql+psycopg://lalonja:cambia-esto@localhost:5432/lalonja
REDIS_URL=redis://localhost:6379/0

# --- Seguridad -------------------------------------------------------------
# Generala con:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# Sin ella la API se niega a arrancar en produccion, a proposito.
JWT_SECRET=
JWT_MINUTOS=30
CORS_ORIGENES=["http://localhost:3000"]

# --- Proveedores de datos --------------------------------------------------
# yfinance no necesita clave. Las demas si, y ninguna es obligatoria para
# desarrollar: el sistema funciona con yfinance y con el proveedor sintetico.
# Ver docs/DATA_SOURCES.md para que aporta cada una y que cuesta.
EODHD_API_KEY=
ALPHAVANTAGE_API_KEY=

# SEC EDGAR no usa clave pero exige identificarse en el User-Agent.
SEC_USER_AGENT="lalonjatrading tu@correo.com"

# --- IA generativa (FASE 16) ----------------------------------------------
# Opcional: sin clave, las explicaciones se declaran no disponibles.
ANTHROPIC_API_KEY=
LLM_MODELO=claude-opus-5
LLM_TIMEOUT_SEGUNDOS=60

# --- Motor -----------------------------------------------------------------
DATOS_DIR=./datos
